<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="koiTile.Pages.ImagePage"
    Background="Transparent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="程序名" />
            <TextBox x:Name="AppNameBox" PlaceholderText="新建磁贴" TextChanged="OnAppNameChanged" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="显示程序名" VerticalAlignment="Center" />
                <ToggleSwitch
                    x:Name="ShowNameToggle"
                    VerticalAlignment="Center"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="OnShowNameToggled" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="命名所有磁贴" VerticalAlignment="Center" />
                <ToggleSwitch
                    x:Name="NumberToggle"
                    VerticalAlignment="Center"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="OnNumberToggled" />
            </StackPanel>
            <Button x:Name="PickButton" Content="上传图片" HorizontalAlignment="Left" Click="OnPick" />
            <TextBlock Text="更新方式：" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ModeBox" CornerRadius="4 0 0 4" MinWidth="140" Margin="0 0 -1 0" Height="34" SelectionChanged="OnModeChanged">
                    <ComboBoxItem Content="轮询" />
                    <ComboBoxItem Content="后台" IsEnabled="False" />
                    <ComboBoxItem Content="推送" IsEnabled="False" />
                    <ComboBoxItem Content="计划" />
                    <ComboBoxItem Content="单击" />
                </ComboBox>
                <NumberBox
                    x:Name="PlanMinutesBox"
                    CornerRadius="0 4 4 0"
                    Height="34"
                    Visibility="Collapsed"
                    ValueChanged="OnPlanMinutesChanged" />
            </StackPanel>
            <ToggleSwitch x:Name="FreeToggle" OffContent="自由定位" OnContent="自由定位" Toggled="OnFreeToggled" />
            <ListView x:Name="ImageList" SelectionMode="Single" MaxHeight="300" SelectionChanged="OnImageSelected">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4">
                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Path}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="色盘" />
            <ColorPicker
                x:Name="Picker"
                HorizontalAlignment="Left"
                ColorSpectrumShape="Box"
                ColorSpectrumComponents="SaturationValue"
                IsAlphaEnabled="False"
                IsAlphaSliderVisible="False"
                IsAlphaTextInputVisible="False"
                IsColorChannelTextInputVisible="True"
                IsHexInputVisible="True"
                IsMoreButtonVisible="False" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ApplyButton" Content="应用" Click="OnApply" />
                <Button x:Name="ResetButton" Content="恢复" Click="OnReset" />
            </StackPanel>
            <TextBlock x:Name="Hint" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
