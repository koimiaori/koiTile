<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="koiTile.Pages.InfoPage"
    Background="Transparent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="10">
            <TextBlock Text="当按下时运行..." />
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="TypeBox"
                    Grid.Column="0"
                    Width="96"
                    SelectedIndex="0"
                    SelectionChanged="OnTypeChanged">
                    <ComboBoxItem Content="url" />
                    <ComboBoxItem Content="命令" />
                </ComboBox>
                <TextBox Grid.Column="1" x:Name="ShortcutBox" TextWrapping="NoWrap" LostFocus="OnShortcutLostFocus" />
                <Button Grid.Column="2" x:Name="BrowseButton" Content="&#x2026;" Click="OnPickShortcut" />
            </Grid>

            <StackPanel x:Name="TriggerAttributes" Orientation="Vertical" Spacing="8">
                <TextBlock Text="任务触发方式" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="TriggerTypeComboBox" CornerRadius="4 0 0 4" Margin="0 0 -1 0" Height="34" SelectedIndex="0" SelectionChanged="OnTriggerTypeChanged">
                        <ComboBoxItem Content="常驻显示" />
                        <ComboBoxItem Content="点击显隐" />
                        <ComboBoxItem Content="时间周期" />
                        <ComboBoxItem Content="系统事件" />
                    </ComboBox>
                    <StackPanel x:Name="TimeTriggerPanel" Orientation="Horizontal">
                        <ComboBox x:Name="TimeTriggerComboBox" CornerRadius="0" SelectionChanged="TimeTriggerComboBox_SelectionChanged" Margin="0 0 -1 0" Height="34" SelectedIndex="0" />
                        <NumberBox x:Name="TimeTriggerTimeSpan" CornerRadius="0 4 4 0" ValueChanged="TimeTriggerTimeSpan_ValueChanged" Height="34" />
                    </StackPanel>
                    <ComboBox x:Name="SystemTriggerComboBox" CornerRadius="0 4 4 0" SelectedIndex="6" Visibility="Collapsed" Height="34" SelectionChanged="OnSystemTriggerChanged" />
                </StackPanel>
            </StackPanel>

            <Pivot x:Name="PivotRoot" Margin="0,8,0,0" SelectionChanged="OnPivotChanged">
                <PivotItem Header="编辑内容">
                    <StackPanel Spacing="10" Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="添加：" VerticalAlignment="Center" />
                            <Button Content="标题" Tag="subtitle" Click="OnAddText" />
                            <Button Content="副标题" Tag="base" Click="OnAddText" />
                            <Button Content="不明显" Tag="captionSubtle" Click="OnAddText" />
                            <Button Content="正文" Tag="default" Click="OnAddText" />
                        </StackPanel>
                        <StackPanel x:Name="ContentPanel" Spacing="10" />
                    </StackPanel>
                </PivotItem>
                <PivotItem Header="编辑Xml">
                    <Grid Padding="0,10,0,0">
                        <RichEditBox
                            x:Name="REBCustom"
                            FontFamily="Consolas"
                            TextWrapping="Wrap"
                            Height="200"
                            TextChanged="OnXmlChanged" />
                    </Grid>
                </PivotItem>
            </Pivot>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="添加至队列" Click="OnAddQueue" />
                <Button Content="删除" Click="OnRemoveQueue" />
            </StackPanel>
            <ListView x:Name="QueueList" MaxHeight="200" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Text}"
                                        FontSize="{Binding Size}"
                                        FontWeight="{Binding Weight}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Hint" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
