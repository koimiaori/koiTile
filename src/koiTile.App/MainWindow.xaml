<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="koiTile.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:koiTile.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="koiTile"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnTitleBarBackRequested"
            PaneToggleRequested="OnPaneToggleRequested" />

        <Grid x:Name="HomeRoot" Grid.Row="1" Padding="24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    Grid.Row="0"
                    AutomationProperties.Name="添加磁贴"
                    HorizontalAlignment="Center"
                    Click="OnAddTileEntry">
                    <StackPanel>
                        <Image Source="ms-appx:///Assets/single.png" Stretch="None" />
                        <TextBlock Text="添加磁贴" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Row="1" Text="添加的磁贴" />
                <GridView
                    Grid.Row="2"
                    x:Name="TileList"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnTileEntryClick">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="140" PointerEntered="OnEntryPointerEntered" PointerExited="OnEntryPointerExited">
                                <Grid Width="140" Height="140">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Visibility="{Binding ImageVisibility}" />
                                </Grid>
                                <Grid ColumnSpacing="4" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        x:Name="RemoveButton"
                                        Content="❌"
                                        Padding="2"
                                        MinWidth="0"
                                        Visibility="Collapsed"
                                        Tag="{Binding}"
                                        Click="OnRemoveEntry" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Label}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button
                    Grid.Row="0"
                    AutomationProperties.Name="添加磁贴组"
                    HorizontalAlignment="Center"
                    Click="OnAddGroupEntry">
                    <StackPanel>
                        <Image Source="ms-appx:///Assets/group.png" Stretch="None" />
                        <TextBlock Text="添加磁贴组" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Row="1" Text="添加的磁贴组" />
                <GridView
                    Grid.Row="2"
                    x:Name="GroupList"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnTileEntryClick">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="140" PointerEntered="OnEntryPointerEntered" PointerExited="OnEntryPointerExited">
                                <Grid Width="140" Height="140">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Visibility="{Binding ImageVisibility}" />
                                </Grid>
                                <Grid ColumnSpacing="4" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        x:Name="RemoveButton"
                                        Content="❌"
                                        Padding="2"
                                        MinWidth="0"
                                        Visibility="Collapsed"
                                        Tag="{Binding}"
                                        Click="OnRemoveEntry" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Label}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

                <Grid x:Name="EditorRoot" Grid.Row="1" Visibility="Collapsed">
            <NavigationView
                x:Name="Nav"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsPaneOpen="False"
                OpenPaneLength="112"
                SelectionChanged="OnNavSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="背景" Tag="background">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7AA;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="信息" Tag="info">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEA4A;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="图标" Tag="icon">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xECAA;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="384" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Frame x:Name="PageHost" />

                    <Grid Grid.Column="1" Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

<Canvas
                        x:Name="PreviewPanel" PointerPressed="OnPreviewStripPressed"
                        Grid.Row="0"
                        Width="488"
                        Height="204"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                        <Border
                            x:Name="SlotLarge"
                            Canvas.Left="38"
                            Width="204"
                            Height="204"
                            Background="Transparent"
                            Tag="3"
                            Tapped="OnPreviewSlotTapped">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,204,204" />
                            </Border.Clip>
                            <controls:TilePreview x:Name="PreviewLarge" />
                        </Border>
                        <Border
                            x:Name="SlotMedium"
                            Canvas.Left="246"
                            Width="100"
                            Height="100"
                            Background="Transparent"
                            Tag="1"
                            Tapped="OnPreviewSlotTapped">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,100,100" />
                            </Border.Clip>
                            <controls:TilePreview x:Name="PreviewMedium" />
                        </Border>
                        <Border
                            x:Name="SlotSmall"
                            Canvas.Left="350"
                            Width="48"
                            Height="48"
                            Background="Transparent"
                            Tag="0"
                            Tapped="OnPreviewSlotTapped">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,48,48" />
                            </Border.Clip>
                            <controls:TilePreview x:Name="PreviewSmall" />
                        </Border>
                        <Border
                            x:Name="SlotWide"
                            Canvas.Left="246"
                            Canvas.Top="104"
                            Width="204"
                            Height="100"
                            Background="Transparent"
                            Tag="2"
                            Tapped="OnPreviewSlotTapped">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,204,100" />
                            </Border.Clip>
                            <controls:TilePreview x:Name="PreviewWide" />
                        </Border>
                        <Border
                            x:Name="RingLarge"
                            Canvas.Left="38"
                            Width="204"
                            Height="204"
                            BorderThickness="2"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="RingMedium"
                            Canvas.Left="246"
                            Width="100"
                            Height="100"
                            BorderThickness="2"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="RingSmall"
                            Canvas.Left="350"
                            Width="48"
                            Height="48"
                            BorderThickness="2"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="RingWide"
                            Canvas.Left="246"
                            Canvas.Top="104"
                            Width="204"
                            Height="100"
                            BorderThickness="2"
                            IsHitTestVisible="False" />
                    </Canvas>

                    <StackPanel
                        x:Name="SwitchPanel"
                        Grid.Row="1"
                        Margin="0,0,0,4"
                        Orientation="Horizontal"
                        Spacing="16">
                        <ToggleSwitch
                            x:Name="UwpToggle"
                            OffContent="UWP磁贴"
                            OnContent="UWP磁贴"
                            VerticalAlignment="Center"
                            Toggled="OnUwpToggled" />
                        <ToggleSwitch
                            x:Name="AutoCropToggle"
                            OffContent="自动裁剪"
                            OnContent="自动裁剪"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Toggled="OnAutoCropToggled" />
                        <ToggleSwitch
                            x:Name="SizeGuideToggle"
                            OffContent="添加尺寸引导"
                            OnContent="添加尺寸引导"
                            VerticalAlignment="Center"
                            Toggled="OnSizeGuideToggled" />
                        <ToggleSwitch
                            x:Name="GuidePreviewToggle"
                            OffContent="引导预览"
                            OnContent="引导预览"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Toggled="OnGuidePreviewToggled" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        ZoomMode="Disabled"
                        HorizontalContentAlignment="Center">
                        <controls:TileBoard x:Name="Board" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
                        <StackPanel x:Name="SizeButtons" Orientation="Horizontal" Spacing="8">
                            <Button Content="小" Click="OnSizeSmall" />
                            <Button Content="中" Click="OnSizeMedium" />
                            <Button x:Name="SizeWideButton" Content="宽" Click="OnSizeWide" />
                            <Button x:Name="SizeLargeButton" Content="大" Click="OnSizeLarge" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Content="添加至开始菜单" Click="OnAddToStart" />
                            <Button Content="恢复默认" Click="OnRestore" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
        <InfoBar
            x:Name="MessageBar"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,50,0,0"
            IsOpen="False"
            IsClosable="True" />
    </Grid>
</Window>
